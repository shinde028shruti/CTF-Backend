# Copy to .env and adjust. Every value below is optional: anything blank or
# missing falls back to the default baked into config/settings.py.
#
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Core ---
SECRET_KEY=replace-with-a-random-50-character-string
DEBUG=True

# --- Hosts and CORS ---
# Comma-separated. ALLOWED_HOSTS must be set when DEBUG=False or Django
# rejects every incoming request.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave False while using JWT bearer tokens; set True only for cookie auth.
CORS_ALLOW_CREDENTIALS=False
# Needed for unsafe methods (POST/PATCH/DELETE) under CSRF protection.
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# SQLite resolves a relative DB_NAME against the backend project root.
# Switching to PostgreSQL/MySQL also needs DB_USER/DB_PASSWORD/DB_HOST/DB_PORT,
# which are not wired up here.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- JWT lifetimes ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=1

# --- Internationalization and files ---
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
STATIC_ROOT=staticfiles

# Not applicable to this project: Celery, drf-spectacular, and DRF versioning
# are not installed, so CELERY_BROKER_URL, SPECTACULAR_* and
# API_DEFAULT_VERSION/API_ALLOWED_VERSIONS have no effect.